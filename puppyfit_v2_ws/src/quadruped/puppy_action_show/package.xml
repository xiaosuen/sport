<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>puppy_action_show</name>
  <version>0.1.0</version>
  <description>
    机器狗动作组表演：通过话题/服务触发 puppypi_control ActionGroups（.d6a/.d6ac），
    底层由 puppy_control 的 runActionGroup 服务执行。
  </description>
  <maintainer email="ubuntu@todo.todo">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>puppy_control_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>puppypi_vendor</exec_depend>
  <exec_depend>puppy_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
