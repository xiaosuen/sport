<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bridge_pkg</name>
  <version>0.0.0</version>
  <description>ROS2 与 PuppyFit 后端 MQTT 桥接：遥测、训练会话、云遥控 teleop 等</description>
  <maintainer email="3490597208@qq.com">ubuntu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>robot_msgs</depend>
  <depend>puppy_control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>exercise_engine_pkg</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>puppy_joy_teleop</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
